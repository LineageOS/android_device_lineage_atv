#
# Key Layout file for B06 Remote.
#

key 116   POWER
key 217   ASSIST       WAKE

key 103   DPAD_UP
key 108   DPAD_DOWN
key 105   DPAD_LEFT
key 106   DPAD_RIGHT
key 353   DPAD_CENTER WAKE

key 158   BACK
key 172   HOME
key 130   ALL_APPS

key 113   VOLUME_MUTE
key 114   VOLUME_DOWN
key 115   VOLUME_UP

key usage 0x000c0078   BUTTON_2     WAKE
key usage 0x000c0077   BUTTON_3     WAKE
key usage 0x000c0079   BUTTON_4     WAKE
