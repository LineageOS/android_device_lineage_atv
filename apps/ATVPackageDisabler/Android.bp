android_app {
    name: "ATVPackageDisabler",

    srcs: ["src/**/*.kt"],

    sdk_version: "current",
    product_specific: true,
    certificate: "platform",
    privileged: true,
    privapp_allowlist: "org.lineageos.atvpackagedisabler.xml",

    optimize: {
        proguard_flags_files: ["proguard.flags"],
    },
}
