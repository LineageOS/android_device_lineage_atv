# NVIDIA Shield Remote (2015)

key 158   BACK
key 172   HOME
key 114   VOLUME_DOWN
key 115   VOLUME_UP
key 164   MEDIA_PLAY_PAUSE

key 103   DPAD_UP
key 105   DPAD_LEFT
key 106   DPAD_RIGHT
key 108   DPAD_DOWN
key 353   DPAD_CENTER     WAKE

key 217   ASSIST          WAKE

# Double tap on volume slider
key usage 0x000c00cd VOLUME_MUTE
