#
# Generic key layout file for full alphabetic US English PC style external keyboards.
#
# This file is intentionally very generic and is intended to support a broad rang of keyboards.
# Do not edit the generic key layout to support a specific keyboard; instead, create
# a new key layout file with the required keyboard configuration.
#

key 116   POWER
key usage 0x0c01bb TV_INPUT
key 156   BOOKMARK
key 217   ASSIST       WAKE
key 384   SETTINGS
key 103   DPAD_UP
key 105   DPAD_LEFT
key 353   DPAD_CENTER  WAKE
key 106   DPAD_RIGHT
key 108   DPAD_DOWN
key 158   BACK
key 172   HOME
key 362   GUIDE
key 114   VOLUME_DOWN
key 115   VOLUME_UP
key 113   VOLUME_MUTE
key 402   CHANNEL_UP
key 403   CHANNEL_DOWN
key usage 0x0c0077  NES_SHORTCUT_04
key usage 0x0c0078  NES_SHORTCUT_03
key usage 0x0c0079  NES_SHORTCUT_02
key usage 0x0c007a  NES_SHORTCUT_08
