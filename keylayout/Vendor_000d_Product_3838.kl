#
# Key Layout file for B016 Remote.
#

key 116   POWER
key 217   ASSIST       WAKE

key 103   DPAD_UP
key 108   DPAD_DOWN
key 105   DPAD_LEFT
key 106   DPAD_RIGHT
key 353   DPAD_CENTER  WAKE

key 158   BACK
key 172   HOME
key 580   APP_SWITCH

key 113   VOLUME_MUTE
key 114   VOLUME_DOWN
key 115   VOLUME_UP

